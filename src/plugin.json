{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "Ourios",
  "id": "ourios-ourios-datasource",
  "metrics": true,
  "logs": true,
  "info": {
    "description": "Query Ourios logs from Grafana",
    "author": {
      "name": "Ourios"
    },
    "keywords": ["datasource", "logs", "ourios"],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [],
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "routes": [
    {
      "path": "ourios",
      "url": "{{ .JsonData.url }}",
      "headers": [
        {
          "name": "x-ourios-tenant",
          "content": "{{ .JsonData.tenant }}"
        }
      ]
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=12.3.0",
    "plugins": []
  }
}
